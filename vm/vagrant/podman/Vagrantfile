# Vagrantfile for the three-VM Ceph lab, podman track
#
# This file tells Vagrant to create the Ceph lab VMs in VirtualBox.
# Ceph is installed on them with cephadm, which runs every daemon in Podman.
# Run every vagrant command from this folder: vm/vagrant/podman/
#
# The snap track (vm/vagrant/snap/Vagrantfile) uses the same VM names and
# addresses. Run only one lab at a time: "vagrant destroy" one before
# "vagrant up" in the other.
#
#   node-01 : Ceph MON, MGR, OSD and first administration host
#   node-02 : Ceph MON, MGR, OSD, second administration host, monitoring, HTTPS gateway
#   node-03 : Ceph MON, MGR and OSD
#   node-04 : optional native RBD client (not started by "vagrant up")
#   node-05 : optional single-node k3s client (not started by "vagrant up")
#
# Every VM gets 2 CPUs and 6 GB of memory. All five together use 10 CPUs
# and 30 GB, which fits a host with 12 CPUs and 40 GB of RAM.
#
# Every VM gets:
#   - a 20 GB OS disk (the box's 10 GB disk, grown by Vagrant)
#   - a private network card with a fixed IP
#
# The three storage VMs also get:
#   - a 20 GB data disk that becomes the first Ceph OSD
#   - a 20 GB reserve disk, left unused until you add it to Ceph when the
#     cluster runs low on space
#
# Vagrant only creates the VMs. Ceph is installed later, first by hand
# and then with Ansible.

# The operating system image every VM starts from.
# It is the official Ubuntu 26.04 cloud image, packaged for Vagrant.
BOX = "cloud-image/ubuntu-26.04"

# Prefix of the VM names in VirtualBox, so you can tell the two tracks apart.
VM_PREFIX = "ceph-lab-podman-"

# Size of the OS disk. The box ships with 10 GB, which is too small for the
# Ceph and monitoring container images, logs and Prometheus data.
# The cloud image grows its root filesystem to fill the disk on first boot.
OS_DISK_SIZE = "20GB"

# Sizes of the two extra disks on every storage VM.
# Vagrant does not format or mount them. Ceph takes them as raw devices.
DATA_DISK_SIZE    = "20GB"   # first OSD
RESERVE_DISK_SIZE = "20GB"   # second OSD, added later to relieve low space

# The list of VMs to create.
# Each VM gets a fixed IP address so Ceph and Ansible can always find it.
# "storage: true" adds the data and reserve disks.
# "autostart: false" means "vagrant up" skips the VM; start it by name.
NODES = [
  { name: "node-01", ip: "192.168.56.11", cpus: 2, memory: 6144, storage: true },
  { name: "node-02", ip: "192.168.56.12", cpus: 2, memory: 6144, storage: true },
  { name: "node-03", ip: "192.168.56.13", cpus: 2, memory: 6144, storage: true },
  { name: "node-04", ip: "192.168.56.14", cpus: 2, memory: 6144, autostart: false },
  { name: "node-05", ip: "192.168.56.15", cpus: 2, memory: 6144, autostart: false },
]

Vagrant.configure("2") do |config|
  config.vm.box = BOX

  # We do not need the shared /vagrant folder inside the VMs.
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Create one VM for each item in the NODES list.
  NODES.each do |node|
    config.vm.define node[:name], autostart: node.fetch(:autostart, true) do |vm|
      # The name you see inside the VM (run "hostname" to check).
      vm.vm.hostname = node[:name]

      # Network card 2: a private (host-only) network card with a fixed IP.
      # Ceph uses this network, and your browser reaches the dashboard on it.
      # (Network card 1 is added by Vagrant automatically, for internet access.
      # It has the same NAT address on every VM, so Ceph must never use it.)
      # nic_type "virtio" is a fast, modern virtual card. Without it VirtualBox
      # picks an old emulated card (PCnet) that is slow and reports no link state.
      vm.vm.network "private_network", ip: node[:ip], nic_type: "virtio"

      # Disk 1, the OS disk, comes from the box and is grown to OS_DISK_SIZE.
      vm.vm.disk :disk, name: "#{node[:name]}-os", size: OS_DISK_SIZE, primary: true

      if node[:storage]
        # Disk 2 (/dev/sdb): the first Ceph data disk.
        vm.vm.disk :disk, name: "#{node[:name]}-data", size: DATA_DISK_SIZE
        # Disk 3 (/dev/sdc): the reserve disk, kept empty until it is needed.
        vm.vm.disk :disk, name: "#{node[:name]}-reserve", size: RESERVE_DISK_SIZE
      end

      # VirtualBox settings: name, CPU and memory.
      # The "ceph-lab-podman-" prefix keeps these VMs apart from the snap
      # track and from other labs.
      vm.vm.provider "virtualbox" do |vb|
        vb.name   = "#{VM_PREFIX}#{node[:name]}"
        vb.cpus   = node[:cpus]
        vb.memory = node[:memory]

        # Turn on the IO-APIC. The box ships with it off, and without it
        # the VM can only use 1 CPU, no matter what "cpus" says.
        vb.customize ["modifyvm", :id, "--ioapic", "on"]
      end
    end
  end
end
